# Goal: dispense `count` pieces from loading station `station_id`
uint8 station_id        # 1..3 (servo 1..3 on the Arduino)
uint8 count             # pieces to dispense; 0 is treated as 1
---
# Result
bool success
uint8 pieces_dispensed
string message
---
# Feedback
string current_operation
uint8 pieces_dispensed
string mechanism_state  # DISCONNECTED | ERROR | HOMING | DISPENSING | DISABLED | IDLE