<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>web_pi_bridge</name>
  <version>0.0.0</version>
  <description>Communication between website and pi</description>
  <maintainer email="amy.kibara@gmail.com">Amy Kibara</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>screen_interfaces</depend>
  <depend>loading_station_interfaces</depend>
  <depend>std_srvs</depend>
  <depend>action_msgs</depend>
  <depend>example_interfaces</depend>
  <depend>ament_index_python</depend>

  <!-- web server (rosdep resolves these to apt packages on Ubuntu 22.04/24.04) -->
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-pydantic</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>